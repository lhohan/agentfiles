#!/usr/bin/env node
/**
 * Usage Statistics Viewer
 *
 * Reads ~/.pi/agent/usage-stats.jsonl and prints aggregated usage
 * statistics for Pi sessions.
 *
 * Usage:
 *   ~/.pi/agent/bin/pi-usage-report
 *   ~/.pi/agent/bin/pi-usage-report --recent
 *   ~/.pi/agent/bin/pi-usage-report --event=skill_invoked
 *   ~/.pi/agent/bin/pi-usage-report --top=5
 */

import {
  STATS_PATH,
  createCollector,
  sortMap,
  readStatsEntries,
  formatPromptDetail,
  createArtifactReports,
} from "./pi-usage-report-lib.mjs";

const { counters, recent, processEntry } = createCollector();

// ── Formatting helpers ──────────────────────────────────────────────

const DIVIDER = "─".repeat(50);

function printHeader(text) {
  console.log(`\n${DIVIDER}`);
  console.log(text);
  console.log(DIVIDER);
}

function printSection(text) {
  console.log(`\n▸ ${text}`);
}

function printSummaryLine(label, value, labelWidth) {
  console.log(`  ${label.padEnd(labelWidth)}  ${value}`);
}

// ── Table rendering ─────────────────────────────────────────────────

function printTable(title, map, topN) {
  const entries = sortMap(map);
  if (entries.length === 0) return;

  const limited = topN ? entries.slice(0, topN) : entries;
  const maxKey = Math.max(...limited.map(([k]) => k.length), 4);

  printSection(title);
  console.log(`  ${"Item".padEnd(maxKey)}  Count`);
  console.log(`  ${"-".repeat(maxKey)}  ${"-".repeat(5)}`);
  for (const [key, count] of limited) {
    console.log(`  ${key.padEnd(maxKey)}  ${count}`);
  }
  if (entries.length > limited.length) {
    console.log(`  … and ${entries.length - limited.length} more`);
  }
}

function printArtifactRows(title, rows, itemLabel, emptyMessage = "No data") {
  printSection(title);
  if (rows.length === 0) {
    console.log(`  (${emptyMessage})`);
    return;
  }

  const maxKey = Math.max(...rows.map((row) => row.name.length), itemLabel.length);
  console.log(`  ${itemLabel.padEnd(maxKey)}  Count`);
  console.log(`  ${"-".repeat(maxKey)}  ${"-".repeat(5)}`);
  for (const row of rows) {
    console.log(`  ${row.name.padEnd(maxKey)}  ${row.count}`);
  }
}

function printArtifactReport(report) {
  printSection(report.label);
  const source = report.includesZeroUse
    ? "inventory-backed; zero-use rows included"
    : "usage-only; zero-use rows are not inferred";
  console.log(`  ${source}`);

  printArtifactRows(
    `Top 10 Most-Used ${report.label}`,
    report.most,
    report.itemLabel,
  );
  printArtifactRows(
    `Top 10 Least-Used ${report.label}`,
    report.least,
    report.itemLabel,
    "no distinct least-used rows after excluding the most-used list",
  );
  printArtifactRows(
    `Full ${report.label} Ranking`,
    report.full,
    report.itemLabel,
  );
}

function printExtensionUsage(counters, topN) {
  const used = sortMap(counters.extensionUsed);
  const installed = new Set(counters.extensionInstalled.keys());

  printSection("Extensions Used");
  console.log(`  ${"Item".padEnd(12)}  Count`);
  console.log(`  ${"-".repeat(12)}  ${"-".repeat(5)}`);

  if (used.length === 0) {
    console.log("  (none observed)");
  } else {
    const limited = topN ? used.slice(0, topN) : used;
    const maxKey = Math.max(...limited.map(([k]) => k.length), 12);
    for (const [key, count] of limited) {
      console.log(`  ${key.padEnd(maxKey)}  ${count}`);
    }
    if (used.length > limited.length) {
      console.log(`  … and ${used.length - limited.length} more`);
    }
  }

  const unused = Array.from(installed)
    .filter((k) => !counters.extensionUsed.has(k))
    .sort();

  if (unused.length > 0) {
    printSection("Installed but not used");
    for (const name of unused) {
      console.log(`  - ${name}`);
    }
  }
}

// ── Recent events ───────────────────────────────────────────────────

function printRecent(count) {
  if (recent.length === 0) return;

  const subset = recent.slice(-count);
  printSection(`Recent Events (last ${Math.min(count, recent.length)})`);

  for (const entry of subset) {
    const time = new Date(entry.t).toISOString().replace("T", " ").replace(/\.\d+$/, "");
    const name = entry.event.padEnd(32);
    const detail = entry.event === "prompt_invoked"
      ? formatPromptDetail(entry)
      : Object.entries(entry)
        .filter(([k]) => k !== "t" && k !== "event")
        .map(([k, v]) => `${k}=${JSON.stringify(v)}`)
        .join(" ");
    console.log(`  ${time}  ${name}  ${detail}`);
  }
}

// ── Main ────────────────────────────────────────────────────────────

async function main() {
  const args = process.argv.slice(2);
  const showRecent =
    args.includes("--recent") || args.some((a) => a.startsWith("--recent="));
  const recentCount = Number(
    args.find((a) => a.startsWith("--recent="))?.slice(9) || 50,
  );
  const filterEvent = args.find((a) => a.startsWith("--event="))?.slice(8);
  const topN = Number(args.find((a) => a.startsWith("--top="))?.slice(6) || 20);

  let lineCount = 0;
  let matchedCount = 0;

  try {
    for await (const entry of readStatsEntries(STATS_PATH)) {
      lineCount++;
      if (filterEvent && entry.event !== filterEvent) continue;
      matchedCount++;
      processEntry(entry);
    }
  } catch (err) {
    if (err.code === "ENOENT") {
      console.error(`Stats file not found: ${STATS_PATH}`);
      console.error("Run Pi with the usage-stats extension first.");
      process.exit(1);
    }
    throw err;
  }

  // Header
  console.log("");
  console.log("  ╔══════════════════════════════════════════════════╗");
  console.log("  ║            Pi Usage Statistics                   ║");
  console.log("  ╚══════════════════════════════════════════════════╝");

  // Summary
  printHeader("  Summary");
  printSummaryLine("Lines processed", lineCount, 16);
  printSummaryLine("Events matched", matchedCount, 16);
  printSummaryLine("Sessions started", counters.sessionStart, 16);

  // Breakdown tables
  printHeader("  Breakdown");
  for (const report of createArtifactReports(counters)) {
    printArtifactReport(report);
  }
  printTable("Extension Slash Commands", counters.extensionCommandInvoked, topN);
  printExtensionUsage(counters, topN);
  printTable("Models Selected", counters.modelSelect, topN);

  // Recent events (optional)
  if (showRecent) {
    printHeader("  Timeline");
    printRecent(recentCount);
  }

  console.log("");
}

main();
