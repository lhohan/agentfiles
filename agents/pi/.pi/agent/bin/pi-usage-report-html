@media (max-width: 720px) { .artifact-summary { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .container { padding: 16px; } h1 { font-size: 1.4rem; } .metric-value { font-size: 1.5rem; } .donut-wrap { justify-content: center; } }
</style>
</head>
<body>
<div class="container">
<header>
  <div>
    <h1><span>Pi</span> Usage Report</h1>
    <div class="timestamp">Generated ${new Date().toLocaleString()}</div>
  </div>
  <label class="interval-controls" for="interval-selector">
    Time interval
    <select id="interval-selector" name="interval" data-interval-selector>${optionsHtml}</select>
  </label>
</header>

${panelsHtml}

<footer>Generated by pi-usage-report-html &middot; Data from ~/.pi/agent/usage-stats.jsonl</footer>
</div>
<script>
(() => {
  const selector = document.querySelector('[data-interval-selector]');
  const panels = Array.from(document.querySelectorAll('[data-interval-panel]'));
  const values = new Set(panels.map((panel) => panel.dataset.intervalPanel));
  const params = new URLSearchParams(window.location.search);
  const queryInterval = params.get('interval');

  function show(interval) {
    if (!values.has(interval)) interval = selector.value;
    selector.value = interval;
    for (const panel of panels) {
      panel.hidden = panel.dataset.intervalPanel !== interval;
    }
    try {
      const url = new URL(window.location.href);
      url.searchParams.set('interval', interval);
      history.replaceState(null, '', url);
    } catch {}
  }

  selector.addEventListener('change', () => show(selector.value));
  show(values.has(queryInterval) ? queryInterval : selector.value);
})();
</script>
</body>
</html>`;

  writeFileSync(outputPath, html, "utf-8");
  return outputPath;
}

async function main() {
  const args = process.argv.slice(2);
  const outputPath = optionValue(args, "--output") || DEFAULT_OUTPUT;
  const recentCount = Number(optionValue(args, "--recent") || 50);
  let selectedInterval;

  try {
    selectedInterval = normalizeTimeInterval(optionValue(args, "--interval"));
  } catch (err) {
    console.error(err.message);
    process.exit(2);
  }

  const entries = [];
  try {
    for await (const entry of readStatsEntries(STATS_PATH)) {
      entries.push(entry);
    }
  } catch (err) {
    if (err.code === "ENOENT") {
      console.error(`Stats file not found: ${STATS_PATH}`);
      console.error("Run Pi with the usage-stats extension first.");
      process.exit(1);
    }
    throw err;
  }

  const now = Date.now();
  const intervalReports = TIME_INTERVAL_OPTIONS.map((option) => ({
    interval: option.value,
    ...collectEntries(entries, option.value, now),
  }));

  const path = generateReport(outputPath, recentCount, intervalReports, selectedInterval);
  console.log(`✅ HTML report written to ${path}`);
  console.log(`   Open it: open ${path}`);
}

main();
