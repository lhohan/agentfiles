  --accent: #6366f1;
  --accent2: #8b5cf6;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #f43f5e;
  --radius: 14px;
  --shadow: 0 4px 24px rgba(0,0,0,0.35);
}
@media (prefers-color-scheme: light) {
