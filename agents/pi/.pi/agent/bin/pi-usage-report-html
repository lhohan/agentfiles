async function main() {
  const args = process.argv.slice(2);
  const outputPath = args.find((a) => a.startsWith("--output="))?.slice(9) || DEFAULT_OUTPUT;
  const recentCount = Number(args.find((a) => a.startsWith("--recent="))?.slice(9) || 50);

  try {
    for await (const entry of readStatsEntries(STATS_PATH)) {
      processEntry(entry);
    }
  } catch (err) {
    if (err.code === "ENOENT") {
      console.error(`Stats file not found: ${STATS_PATH}`);
      console.error("Run Pi with the usage-stats extension first.");
      process.exit(1);
    }
    throw err;
  }

  const path = generateReport(outputPath, recentCount);
  console.log(`✅ HTML report written to ${path}`);
  console.log(`   Open it: open ${path}`);
}

main();
