    <div class="metric-value">${counters.sessionStart.toLocaleString()}</div>
    <div class="metric-label">Sessions</div>
  </div>
  <div class="metric">
    <div class="metric-value">${totalEvents.toLocaleString()}</div>
    <div class="metric-label">Total Events</div>
  </div>
  <div class="metric">
    <div class="metric-value">${totalSkills}</div>
    <div class="metric-label">Skills Loaded</div>
  </div>
  <div class="metric">
    <div class="metric-value">${totalModels}</div>
    <div class="metric-label">Models Tried</div>
  </div>
  <div class="metric">
    <div class="metric-value">${counters.resourcesDiscovered.prompts.toLocaleString()}</div>
    <div class="metric-label">Prompts Discovered</div>
  </div>
</div>

<section>
  <h2><span class="icon">📈</span> Activity Timeline</h2>
  ${generateTimelineChart(timeline)}
</section>

<section>
  <h2><span class="icon">🤖</span> Models Used</h2>
  ${generateDonutChart(sortMap(counters.modelUsed))}
</section>

<div class="grid-2">
  <section>
    <h2><span class="icon">🔧</span> Custom Tools</h2>
    ${generateBarChart(sortMap(counters.customToolCalled), 8, "#f43f5e")}
  </section>
  <section>
    <h2><span class="icon">📝</span> Top Prompts</h2>
    ${generateBarChart(sortMap(counters.promptInvoked), 8, "#10b981")}
  </section>
</div>

<section>
  <h2><span class="icon">⚡</span> Extension Commands</h2>
  ${renderTable(sortMap(counters.extensionCommandInvoked), ["Command", "Count"])}
</section>

<section>
  <h2><span class="icon">🧩</span> Extensions loaded</h2>
  ${renderTable(sortMap(counters.extensionLoaded), ["Extension", "Count"])}
</section>

<section>
  <h2><span class="icon">📦</span> Skills Loaded</h2>
  ${renderList(sortSet(counters.skillLoaded), "Skill")}
