  font-size: 2rem;
  font-weight: 700;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.metric-label { font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.04em; }

section {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  padding: 24px;
  margin-bottom: 24px;
  box-shadow: var(--shadow);
}
h2 { font-size: 1.15rem; font-weight: 600; margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px; }
h2 .icon { font-size: 1.3rem; }

.grid-2 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
}

.bar-chart { width: 100%; height: auto; }
.bar-chart .label { font-size: 11px; fill: var(--text-muted); }
.bar-chart .value { font-size: 11px; fill: var(--text); font-weight: 600; }

.donut-wrap { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
.donut { width: 240px; height: 200px; flex-shrink: 0; }
.donut-total { font-size: 22px; font-weight: 700; fill: var(--text); }
.legend { display: flex; flex-direction: column; gap: 8px; }
.legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
.swatch { width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0; }
.legend-label { color: var(--text); }
