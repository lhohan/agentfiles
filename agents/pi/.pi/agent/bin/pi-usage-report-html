#!/usr/bin/env node
/**
 * Usage Statistics HTML Report Generator
 *
 * Reads ~/.pi/agent/usage-stats.jsonl and generates a self-contained
 * interactive HTML report.
 *
 * Usage:
 *   ~/.pi/agent/bin/pi-usage-report-html
 *   ~/.pi/agent/bin/pi-usage-report-html --output=/path/to/report.html
 *   ~/.pi/agent/bin/pi-usage-report-html --recent=200
 *   ~/.pi/agent/bin/pi-usage-report-html --interval="last 7 days"
 */

import {
  STATS_PATH,
  TIME_INTERVAL_OPTIONS,
  createCollector,
  sortMap,
  readStatsEntries,
  formatPromptDetail,
  createArtifactReports,
  entryMatchesTimeInterval,
  normalizeTimeInterval,
} from "./pi-usage-report-lib.mjs";
import { writeFileSync } from "node:fs";

const DEFAULT_OUTPUT = `${process.env.HOME}/.pi/agent/usage-report.html`;

function optionValue(args, name) {
  const prefix = `${name}=`;
  const inline = args.find((arg) => arg.startsWith(prefix));
  if (inline) return inline.slice(prefix.length);

  const index = args.indexOf(name);
  if (index !== -1 && args[index + 1] && !args[index + 1].startsWith("--")) {
    return args[index + 1];
  }
  return undefined;
}

function collectEntries(entries, interval, now) {
  const collector = createCollector({ trackTimeline: true });
  for (const entry of entries) {
    if (entryMatchesTimeInterval(entry, interval, now)) {
      collector.processEntry(entry);
    }
  }
  return collector;
}

function escapeHtml(str) {
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function generateBarChart(entries, maxBars = 10, color = "#6366f1") {
  const limited = entries.slice(0, maxBars);
  if (limited.length === 0) return "<p class=\"empty\">No data</p>";
  const maxVal = Math.max(...limited.map(([, v]) => v));
  const maxLabelLen = Math.max(...limited.map(([k]) => k.length));
  const barWidth = 300;
  const barHeight = 24;
  const gap = 12;
  const labelWidth = Math.min(maxLabelLen * 8 + 8, 180);
  const totalWidth = labelWidth + barWidth + 60;
  const totalHeight = limited.length * (barHeight + gap) + gap;

  let svg = `<svg viewBox="0 0 ${totalWidth} ${totalHeight}" class="bar-chart">`;
  for (let i = 0; i < limited.length; i++) {
    const [key, val] = limited[i];
    const y = gap + i * (barHeight + gap);
    const w = maxVal > 0 ? (val / maxVal) * barWidth : 0;
    svg += `<text x="${labelWidth - 8}" y="${y + barHeight / 2 + 4}" text-anchor="end" class="label">${escapeHtml(key)}</text>`;
    svg += `<rect x="${labelWidth}" y="${y}" width="${w}" height="${barHeight}" rx="4" fill="${color}" opacity="0.85"/>`;
    svg += `<text x="${labelWidth + w + 8}" y="${y + barHeight / 2 + 4}" class="value">${val}</text>`;
  }
  svg += "</svg>";
  return svg;
}

function generateDonutChart(entries, maxSlices = 8) {
  const total = entries.reduce((s, [, v]) => s + v, 0);
  if (total === 0) return "<p class=\"empty\">No data</p>";

  const colors = [
    "#6366f1", "#8b5cf6", "#ec4899", "#f43f5e",
    "#f59e0b", "#10b981", "#06b6d4", "#3b82f6",
    "#84cc16", "#d946ef", "#f97316", "#ef4444",
  ];

  const sorted = entries.slice().sort((a, b) => b[1] - a[1]);
  const slices = sorted.slice(0, maxSlices);
  const otherSum = sorted.slice(maxSlices).reduce((s, [, v]) => s + v, 0);
  if (otherSum > 0) slices.push(["Other", otherSum]);

  const r = 80;
  const cx = 120;
  const cy = 100;
  const innerR = 50;
  let angle = -Math.PI / 2;
  let paths = "";
  let legend = "";

  for (let i = 0; i < slices.length; i++) {
    const [key, val] = slices[i];
    const sliceAngle = (val / total) * 2 * Math.PI;
    const x1 = cx + r * Math.cos(angle);
    const y1 = cy + r * Math.sin(angle);
    const x2 = cx + r * Math.cos(angle + sliceAngle);
    const y2 = cy + r * Math.sin(angle + sliceAngle);
    const x3 = cx + innerR * Math.cos(angle + sliceAngle);
    const y3 = cy + innerR * Math.sin(angle + sliceAngle);
    const x4 = cx + innerR * Math.cos(angle);
    const y4 = cy + innerR * Math.sin(angle);
    const largeArc = sliceAngle > Math.PI ? 1 : 0;
    const color = colors[i % colors.length];
    const d = `M ${x1} ${y1} A ${r} ${r} 0 ${largeArc} 1 ${x2} ${y2} L ${x3} ${y3} A ${innerR} ${innerR} 0 ${largeArc} 0 ${x4} ${y4} Z`;
    paths += `<path d="${d}" fill="${color}" stroke="var(--card-bg)" stroke-width="2"/>`;
    const pct = Math.round((val / total) * 100);
    legend += `<div class="legend-item"><span class="swatch" style="background:${color}"></span><span class="legend-label">${escapeHtml(key)}</span><span class="legend-pct">${pct}%</span></div>`;
    angle += sliceAngle;
  }

  return `<div class="donut-wrap"><svg viewBox="0 0 240 200" class="donut">${paths}<text x="${cx}" y="${cy + 5}" text-anchor="middle" class="donut-total">${total}</text></svg><div class="legend">${legend}</div></div>`;
}

function generateTimelineChart(timeline) {
  const bucketMs = 1000 * 60 * 60 * 24;
  const buckets = new Map();
  for (const entry of timeline) {
    const bucket = Math.floor(entry.t / bucketMs) * bucketMs;
    buckets.set(bucket, (buckets.get(bucket) || 0) + 1);
  }
  const sorted = Array.from(buckets.entries()).sort((a, b) => a[0] - b[0]);
  if (sorted.length < 2) return "<p class=\"empty\">Not enough timeline data</p>";

  const maxVal = Math.max(...sorted.map(([, v]) => v));
  const w = 600;
  const h = 160;
  const pad = { top: 10, right: 10, bottom: 30, left: 40 };
  const chartW = w - pad.left - pad.right;
  const chartH = h - pad.top - pad.bottom;
  const minT = sorted[0][0];
  const maxT = sorted[sorted.length - 1][0];

  let points = "";
  for (const [t, val] of sorted) {
    const x = pad.left + ((t - minT) / (maxT - minT || 1)) * chartW;
    const y = pad.top + chartH - (val / maxVal) * chartH;
    points += `${x},${y} `;
  }

  let grid = "";
  for (let i = 0; i <= 4; i++) {
    const y = pad.top + (chartH * i) / 4;
    const val = Math.round(maxVal * (1 - i / 4));
    grid += `<line x1="${pad.left}" y1="${y}" x2="${w - pad.right}" y2="${y}" class="grid"/>`;
    grid += `<text x="${pad.left - 6}" y="${y + 3}" text-anchor="end" class="axis">${val}</text>`;
  }

  let xLabels = "";
  const labelCount = Math.min(sorted.length, 6);
  for (let i = 0; i < labelCount; i++) {
    const idx = Math.floor((i / (labelCount - 1)) * (sorted.length - 1));
    const [t] = sorted[idx];
    const x = pad.left + ((t - minT) / (maxT - minT || 1)) * chartW;
    const date = new Date(t).toLocaleDateString(undefined, { month: "short", day: "numeric" });
    xLabels += `<text x="${x}" y="${h - 6}" text-anchor="middle" class="axis">${date}</text>`;
  }

  const firstX = pad.left;
  const lastX = pad.left + chartW;
  const bottomY = pad.top + chartH;
  const areaPath = `M ${firstX} ${bottomY} L ${points.split(" ").filter(Boolean).join(" L ")} L ${lastX} ${bottomY} Z`;

  return `<svg viewBox="0 0 ${w} ${h}" class="timeline-chart"><defs><linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#6366f1" stop-opacity="0.3"/><stop offset="100%" stop-color="#6366f1" stop-opacity="0"/></linearGradient></defs>${grid}<path d="${areaPath}" fill="url(#areaGrad)"/><polyline points="${points}" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>${xLabels}</svg>`;
}

function renderTable(entries, headers, limit = 20) {
  if (entries.length === 0) return "<p class=\"empty\">No data</p>";
  const visible = limit ? entries.slice(0, limit) : entries;
  let rows = "";
  for (const [key, val] of visible) {
    rows += `<tr><td>${escapeHtml(key)}</td><td class="num">${val}</td></tr>`;
  }
  return `<table><thead><tr>${headers.map((h) => `<th>${escapeHtml(h)}</th>`).join("")}</tr></thead><tbody>${rows}</tbody></table>`;
}

function renderArtifactRows(rows, itemLabel, emptyMessage = "No data") {
  if (rows.length === 0) return `<p class="empty">${escapeHtml(emptyMessage)}</p>`;
  let html = "";
  for (const row of rows) {
    html += `<tr><td>${escapeHtml(row.name)}</td><td class="num">${row.count}</td></tr>`;
  }
  return `<table><thead><tr><th>${escapeHtml(itemLabel)}</th><th>Count</th></tr></thead><tbody>${html}</tbody></table>`;
}

function artifactIcon(id) {
  switch (id) {
    case "prompts": return "📝";
    case "skills": return "📦";
    case "customTools": return "🔧";
    case "enabledModels": return "🤖";
    default: return "📊";
  }
}

function renderArtifactSummary(reports) {
  const cards = reports.map((report) => {
    const rows = report.most.slice(0, 5);
    const maxCount = Math.max(...rows.map((row) => row.count), 0);
    const body = rows.length === 0
      ? `<p class="empty compact">No usage observed</p>`
      : `<div class="summary-bars">${rows.map((row) => {
        const width = maxCount > 0 ? Math.max((row.count / maxCount) * 100, 3) : 3;
        return `<div class="summary-bar-row">
          <div class="summary-bar-meta"><span>${escapeHtml(row.name)}</span><strong>${row.count}</strong></div>
          <div class="summary-bar-track"><div class="summary-bar-fill" style="width:${width.toFixed(1)}%"></div></div>
        </div>`;
      }).join("")}</div>`;
    return `<div class="summary-card ${report.id}"><h3>${artifactIcon(report.id)} ${escapeHtml(report.label)}</h3>${body}</div>`;
  }).join("");

  return `<section>
  <h2><span class="icon">🏁</span> Artifact Usage at a Glance</h2>
  <div class="artifact-summary">${cards}</div>
</section>`;
}

function renderArtifactReport(report) {
  const source = report.includesZeroUse
    ? "Inventory-backed; zero-use rows included."
    : "Usage-only; zero-use rows are not inferred.";

  return `<section class="artifact-report">
  <h2><span class="icon">${artifactIcon(report.id)}</span> ${escapeHtml(report.label)}</h2>
  <p class="source-note">${source}</p>
  <div class="grid-2">
    <div>
      <h3>Top 10 Most-Used</h3>
      ${renderArtifactRows(report.most, report.itemLabel)}
    </div>
    <div>
      <h3>Top 10 Least-Used</h3>
      ${renderArtifactRows(report.least, report.itemLabel, "No distinct least-used rows after excluding the most-used list")}
    </div>
  </div>
  <h3 class="full-ranking-heading">Full Ranking</h3>
  ${renderArtifactRows(report.full, report.itemLabel)}
</section>`;
}

function renderExtensionUsage(counters) {
  const used = sortMap(counters.extensionUsed);
  const installed = Array.from(counters.extensionInstalled.keys()).sort();
  const unused = installed.filter((k) => !counters.extensionUsed.has(k));

  let html = used.length === 0
    ? `<p class="empty">No extension usage observed</p>`
    : renderTable(used, ["Extension", "Count"]);

  if (unused.length > 0) {
    html += `<h3 style="margin-top:16px;font-size:0.95rem;color:var(--text-muted);">Installed but not used</h3>`;
    html += `<ul style="margin:8px 0 0 0;padding-left:20px;color:var(--text-muted);font-size:0.85rem;">`;
    for (const name of unused) html += `<li>${escapeHtml(name)}</li>`;
    html += `</ul>`;
  }

  return html;
}

function renderRecent(events, count) {
  if (events.length === 0) return `<p class="empty">No events in this interval</p>`;
  const subset = events.slice(-count).reverse();
  let rows = "";
  for (const entry of subset) {
    const time = new Date(entry.t).toLocaleString();
    const badgeClass = String(entry.event).toLowerCase();
    const detail = entry.event === "prompt_invoked"
      ? formatPromptDetail(entry)
      : Object.entries(entry)
        .filter(([k]) => k !== "t" && k !== "event")
        .map(([k, v]) => `${k}=${JSON.stringify(v)}`)
        .join(" ");
    rows += `<tr><td class="time">${time}</td><td><span class="badge ${badgeClass}">${escapeHtml(entry.event)}</span></td><td class="detail">${escapeHtml(detail || "—")}</td></tr>`;
  }
  return `<table class="recent"><thead><tr><th>Time</th><th>Event</th><th>Details</th></tr></thead><tbody>${rows}</tbody></table>`;
}

function renderIntervalPanel(report, recentCount) {
  const { interval, counters, recent, timeline } = report;
  const artifactReports = createArtifactReports(counters);
  const totalEvents = timeline.length;
  const totalSkills = counters.skillLoaded.size;
  const totalModels = counters.modelUsed.size;
  const firstEvent = timeline.length > 0 ? new Date(timeline[0].t).toLocaleDateString() : "—";
  const lastEvent = timeline.length > 0 ? new Date(timeline[timeline.length - 1].t).toLocaleDateString() : "—";

  return `<div class="interval-heading">
  <div class="subtitle">${totalEvents.toLocaleString()} events &middot; ${firstEvent} – ${lastEvent} &middot; interval: ${escapeHtml(interval)}</div>
</div>

<div class="metrics">
  <div class="metric"><div class="metric-value">${counters.sessionStart.toLocaleString()}</div><div class="metric-label">Sessions</div></div>
  <div class="metric"><div class="metric-value">${totalEvents.toLocaleString()}</div><div class="metric-label">Total Events</div></div>
  <div class="metric"><div class="metric-value">${totalSkills}</div><div class="metric-label">Skills Loaded</div></div>
  <div class="metric"><div class="metric-value">${totalModels}</div><div class="metric-label">Models Tried</div></div>
</div>

<section>
  <h2><span class="icon">📈</span> Activity Timeline</h2>
  ${generateTimelineChart(timeline)}
</section>

${renderArtifactSummary(artifactReports)}

<div class="grid-2">
  <section>
    <h2><span class="icon">🤖</span> Models Used</h2>
    ${generateDonutChart(sortMap(counters.modelUsed))}
  </section>
  <section>
    <h2><span class="icon">📦</span> Skills Used</h2>
    ${generateDonutChart(sortMap(counters.skillLoaded))}
  </section>
</div>

${artifactReports.map(renderArtifactReport).join("\n")}

${counters.extensionCommandInvoked.size > 0 ? `<section>
  <h2><span class="icon">⚡</span> Extension Slash Commands</h2>
  ${renderTable(sortMap(counters.extensionCommandInvoked), ["Command", "Count"])}
</section>` : ""}

<section>
  <h2><span class="icon">🧩</span> Extensions Used</h2>
  ${renderExtensionUsage(counters)}
</section>

<section>
  <h2><span class="icon">🕒</span> Recent Events</h2>
  ${renderRecent(recent, recentCount)}
</section>`;
}

function generateReport(outputPath, recentCount, intervalReports, selectedInterval) {
  const optionsHtml = TIME_INTERVAL_OPTIONS.map((option) => {
    const selected = option.value === selectedInterval ? " selected" : "";
