  }).join("");

  const panelsHtml = intervalReports.map((report) => {
    const hidden = report.interval === selectedInterval ? "" : " hidden";
    return `<div class="interval-panel" data-interval-panel="${escapeHtml(report.interval)}"${hidden}>${renderIntervalPanel(report, recentCount)}</div>`;
  }).join("\n");

  const html = `<!DOCTYPE html>
<html lang="en">
