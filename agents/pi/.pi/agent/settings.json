{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "theme": "kanagawa-dragon",
  "terminal": {
    "showImages": true
  },
  "images": {
    "autoResize": false
  },
  "editorPaddingX": 2,
  "compaction": {
    "enabled": true
  },
  "treeFilterMode": "default",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-prompt-template-model@0.7.3",
    "npm:pi-answer@0.1.4"
  ],
  "enabledModels": [
    "opencode-go/kimi-k2.7-code",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/minimax-m3",
    "opencode-go/glm-5.3",
    "opencode-go/glm-5.3-flash",
    "opencode-go/longcat-2.0",
    "opencode-go/gpt-5.6-luna",
    "opencode-go/hy3",
    "opencode-go/hy4-preview",
    "opencode-go/qwen3.8-flash",
    "mistral/mistral-medium-3.5",
    "mistral/zai-glm-5-2",
    "mistral/mistral-small-2603",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "omlx/medgemma-1.5-4b-it-4bit",
    "omlx/GLM-OCR-4bit",
    "omlx/Qwen3.5-9B-MLX-4bit"
  ],
  "enableSkillCommands": true,
  "showHardwareCursor": true,
  "autocompleteMaxVisible": 5,
  "quietStartup": false,
  "doubleEscapeAction": "tree",
  "sessionStartModel": {
    "model": "openai-codex/gpt-5.6-luna",
    "thinkingLevel": "high"
  },
  "answer": {
    "extractionModels": [
      {
        "provider": "omlx",
        "id": "Qwen3.5-9B-MLX-4bit"
      },
      {
        "provider": "mistral",
        "id": "mistral-small-2603"
      }
    ],
    "answerTemplates": [
      {
        "label": "Brief",
        "template": "{{answer}}"
      },
      {
        "label": "Need info",
        "template": "I need more details about: {{question}}"
      },
      {
        "label": "Structured",
        "template": "Q{{index}}: {{answer}}"
      },
      {
        "label": "Ack",
        "template": "Regarding {{question}}, I confirm: {{answer}}"
      }
    ],
    "drafts": {
      "enabled": true,
      "autosaveMs": 1000,
      "promptOnRestore": true
    }
  }
}
